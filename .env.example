# ==============================================================================
# MAGI SYSTEM (SUPERCOMPUTER TRINITY CONFIGURATION)
# Inspired by the MAGI Supercomputer from Neon Genesis Evangelion.
# Each node represents one facet of Dr. Naoko Akagi.
# Configure each node directly with its dedicated API key, model, and endpoint.
# ==============================================================================

# SpacetimeDB Engine (In-Memory Deliberation & State Engine)
SPACETIMEDB_URI=http://spacetimedb:3000
SPACETIMEDB_DATABASE=magi-system

# General Settings
MAGI_TIMEOUT_SECONDS=60
MAGI_AUTHOR=developer@magi

# ------------------------------------------------------------------------------
# NODE 1: MELCHIOR-1 (The Scientist — Logic, Architecture & Technical Viability)
# Evaluates code quality, system design, scalability, and algorithms.
# ------------------------------------------------------------------------------
MELCHIOR_API_KEY=
MELCHIOR_MODEL=gemini-flash-lite-latest
MELCHIOR_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai
MELCHIOR_PROVIDER=openai

# ------------------------------------------------------------------------------
# NODE 2: BALTHASAR-2 (The Mother — Cybersecurity, Risk & VETO Authority)
# Evaluates OWASP Top 10, CWE detection, secret leaks, and security risks.
# Possesses unilateral VETO power over the deliberation (risk_score >= 8).
# ------------------------------------------------------------------------------
BALTHASAR_API_KEY=
BALTHASAR_MODEL=llama-3.3-70b-versatile
BALTHASAR_ENDPOINT=https://api.groq.com/openai/v1
BALTHASAR_PROVIDER=openai

# ------------------------------------------------------------------------------
# NODE 3: CASPER-3 (The Woman / Person — Pragmatism, DX, Cost & Simplicity)
# Evaluates feasibility, cognitive overhead, implementation effort, and overengineering.
# ------------------------------------------------------------------------------
CASPER_API_KEY=
CASPER_MODEL=meta-llama/llama-3.2-3b-instruct:free
CASPER_ENDPOINT=https://openrouter.ai/api/v1
CASPER_PROVIDER=openai
