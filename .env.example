# ==============================================================================
# MAGI SYSTEM (SUPERCOMPUTER TRINITY CONFIGURATION)
# Inspired by the MAGI Supercomputer from Neon Genesis Evangelion.
# Each node represents one facet of Dr. Naoko Akagi.
# ==============================================================================

# SpacetimeDB Engine (In-Memory Deliberation & State Engine)
SPACETIMEDB_URI=http://spacetimedb:3000
SPACETIMEDB_DATABASE=magi-system

# General Settings
MAGI_TIMEOUT_SECONDS=60
MAGI_AUTHOR=developer@magi
# Language override: 'es' (Spanish), 'en' (English), or auto-detected from prompt/locale
MAGI_LANG=

# Stability, Resilience & Quorum Safeguards
# Maximum retry attempts on 429/5xx transient HTTP errors (default: 3)
MAGI_MAX_RETRIES=3
# Initial backoff delay in ms for exponential retry (default: 1000)
MAGI_RETRY_DELAY_MS=1000
# Allow 2-of-3 degraded quorum when 1 node is unreachable/exhausted (default: true)
MAGI_ALLOW_DEGRADED_QUORUM=true
# Maximum payload context chars before intelligent head-tail truncation (default: 60000)
MAGI_MAX_CONTEXT_CHARS=60000
# Maximum output generation tokens per LLM completion (default: 4096).
# Can also be overridden per node: MELCHIOR_MAX_TOKENS, BALTHASAR_MAX_TOKENS, CASPER_MAX_TOKENS
MAGI_MAX_TOKENS=4096
# Contingency Backup Brain / Failover Model (Hot Standby)
# Automatically engaged if a node's primary model fails (e.g. out of API credits, persistent 429/5xx).
# Can also be overridden per node: MELCHIOR_FALLBACK_MODEL, BALTHASAR_FALLBACK_MODEL, CASPER_FALLBACK_MODEL
MAGI_FALLBACK_MODEL=cohere/north-mini-code:free

# ==============================================================================
# OPTION A: UNIVERSAL GLOBAL CONFIGURATION (Recommended)
# Configure a single endpoint, model, and key for all 3 Trinity nodes.
# ==============================================================================
# Cloud Examples:
#   OpenAI:      ENDPOINT=https://api.openai.com/v1                          MODEL=gpt-4o-mini
#   DeepSeek:    ENDPOINT=https://api.deepseek.com/v1                        MODEL=deepseek-chat
#   OpenRouter:  ENDPOINT=https://openrouter.ai/api/v1                       MODEL=anthropic/claude-3.5-sonnet
#   Google:      ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai  MODEL=gemini-2.5-flash
#
# Local / Offline Examples (No API Key Required):
#   Ollama:      ENDPOINT=http://localhost:11434/v1                         MODEL=qwen2.5-coder:7b
#   LM Studio:   ENDPOINT=http://localhost:1234/v1                          MODEL=local-model
#   vLLM:        ENDPOINT=http://localhost:8000/v1                          MODEL=qwen2.5-coder:7b

MAGI_ENDPOINT=http://localhost:11434/v1
MAGI_MODEL=qwen2.5-coder:7b
MAGI_API_KEY=

# ==============================================================================
# OPTION B: GRANULAR PER-NODE OVERRIDES (Optional)
# If set, these override the global MAGI_* settings for individual personas.
# ==============================================================================

# MELCHIOR-1 (The Scientist — Logic, Architecture & Scalability)
# MELCHIOR_ENDPOINT=http://localhost:11434/v1
# MELCHIOR_MODEL=qwen2.5-coder:7b
# MELCHIOR_API_KEY=

# BALTHASAR-2 (The Mother — Cybersecurity, Defensive Invariants & VETO)
# BALTHASAR_ENDPOINT=http://localhost:11434/v1
# BALTHASAR_MODEL=qwen2.5-coder:7b
# BALTHASAR_API_KEY=

# CASPER-3 (The Woman — Pragmatism, DX, Simplicity & Cost)
# CASPER_ENDPOINT=http://localhost:11434/v1
# CASPER_MODEL=qwen2.5-coder:7b
# CASPER_API_KEY=
